project_id             = "mhcet-app"
region                 = "asia-south1"
environment            = "prod"
frontend_domain        = "example.com"
backend_domain         = "api.example.com"
cors_allowed_origins   = "https://example.com"
db_tier                = "db-custom-1-3840"
backend_min_instances  = 1
frontend_min_instances = 0
backend_max_instances  = 5
frontend_max_instances = 5

backend_image  = "us-docker.pkg.dev/cloudrun/container/hello"
frontend_image = "us-docker.pkg.dev/cloudrun/container/hello"

# --- Auth (Google OAuth whole-app gate) ---
# Parent registrable domain shared by example.com / api.example.com / ai-api.example.com.
session_cookie_domain      = "example.com"
google_oauth_client_id     = "xxxxxxxx.apps.googleusercontent.com"
# Supply via TF_VAR_google_oauth_client_secret; do not commit. Empty = no secret version written.
google_oauth_client_secret = ""
